# Server-side only — never exposed to the browser
ANTHROPIC_API_KEY=
# Model identifier to use for generation (see your Anthropic console)
ANTHROPIC_MODEL=
# Reasoning effort: low | medium | high | xhigh | max (empty = provider default)
ANTHROPIC_EFFORT=medium
# Server-side fallback model on policy declines; set to "off" for models that do not support it
ANTHROPIC_FALLBACKS=on
# 1 = serve built-in demo data instead of calling the API (no key needed)
CHRONOS_MOCK=0
API_PORT=8787
