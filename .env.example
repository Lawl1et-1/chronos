# Server-side only — never exposed to the browser

# Provider: gemini (free tier, default) or anthropic
LLM_PROVIDER=gemini

# Gemini — free key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is overloaded, out of quota or too slow
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash
GEMINI_TIMEOUT_MS=90000

# Anthropic (optional, paid) — used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=on

# 1 = serve built-in demo data instead of calling the API (no key needed)
CHRONOS_MOCK=0
API_PORT=8787
