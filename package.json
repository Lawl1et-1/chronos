{
  "name": "chronos",
  "version": "1.0.0",
  "description": "Simulateur d'histoire alternative en 3D.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "textures": "node scripts/textures.mjs",
    "start": "npm run build && tsx server/index.ts --static",
    "build:pages": "tsc --noEmit && vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lawl1et-1/chronos.git"
  },
  "author": "Lawl1et-1",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Lawl1et-1/chronos/issues"
  },
  "homepage": "https://github.com/Lawl1et-1/chronos#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "d3-geo": "^3.1.1",
    "earcut": "^3.2.4",
    "express": "^5.3.0",
    "framer-motion": "^14.6.0",
    "i18n-iso-countries": "^7.14.0",
    "partial-json": "^0.1.7",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/earcut": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three-globe": "^2.45.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
